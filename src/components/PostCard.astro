---
import type { CollectionEntry } from 'astro:content';
import { slugFromId } from '../lib/posts';
import { categoryDisplayName } from '../data/categories';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const slug = slugFromId(post.id);
const dateStr = post.data.date.toISOString().slice(0, 10);
---

<li class="post-card">
  <h3 class="post-card__title"><a href={`/posts/${slug}/`}>{post.data.title}</a></h3>
  <p class="post-card__meta">
    <time datetime={dateStr}>{dateStr}</time>
    &nbsp;·&nbsp;
    <a href={`/topics/${post.data.category}/`}>{categoryDisplayName(post.data.category)}</a>
    {post.data.minutesRead && (
      <>
        &nbsp;·&nbsp;
        {post.data.minutesRead} 分钟阅读
      </>
    )}
  </p>
  {post.data.description && <p class="post-card__desc">{post.data.description}</p>}
</li>
