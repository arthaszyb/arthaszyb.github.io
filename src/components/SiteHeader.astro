---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const { pathname } = Astro.url;

function isActive(path: string) {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-title" href="/">{site.title}</a>
    <nav class="site-nav" aria-label="主导航">
      <a href="/posts/" aria-current={isActive('/posts') ? 'page' : undefined}>文章</a>
      <a href="/topics/" aria-current={isActive('/topics') ? 'page' : undefined}>主题</a>
      <a href="/archive/" aria-current={isActive('/archive') ? 'page' : undefined}>归档</a>
      <a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>关于</a>
      <a href="/search/" aria-current={isActive('/search') ? 'page' : undefined}>搜索</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
