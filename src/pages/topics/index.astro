---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { categoryDisplayName } from '../../data/categories';

const posts = await getPublishedPosts();
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
const topics = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([slug, count]) => ({ slug, count, name: categoryDisplayName(slug) }));
---

<BaseLayout title="主题" description="按主题浏览全部文章">
  <div class="wrap-wide">
    <h1>主题</h1>
    <div class="topic-grid">
      {
        topics.map((topic) => (
          <a class="topic-card" href={`/topics/${topic.slug}/`}>
            <div>{topic.name}</div>
            <div class="topic-card__count">{topic.count} 篇</div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
