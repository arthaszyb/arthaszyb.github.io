---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, slugFromId } from '../lib/posts';
import { categoryDisplayName } from '../data/categories';
import { site } from '../data/site';

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
const recent = rest.slice(0, 8);

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
const topics = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([slug, count]) => ({ slug, count, name: categoryDisplayName(slug) }));
---

<BaseLayout>
  <div class="wrap-wide">
    <p class="kicker">Sean Jho</p>
    <p>{site.description}</p>

    {
      featured && (
        <section class="featured-card">
          <p class="kicker">最新</p>
          <h2 style="margin-top:0">
            <a href={`/posts/${slugFromId(featured.id)}/`}>{featured.data.title}</a>
          </h2>
          {featured.data.description && <p>{featured.data.description}</p>}
        </section>
      )
    }

    <div class="section-heading">
      <h2>近期文章</h2>
      <a href="/posts/">全部文章 &rarr;</a>
    </div>
    <ul class="post-list">
      {recent.map((post) => <PostCard post={post} />)}
    </ul>

    <div class="section-heading">
      <h2>主题</h2>
      <a href="/topics/">全部主题 &rarr;</a>
    </div>
    <div class="topic-grid">
      {
        topics.map((topic) => (
          <a class="topic-card" href={`/topics/${topic.slug}/`}>
            <div>{topic.name}</div>
            <div class="topic-card__count">{topic.count} 篇</div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
