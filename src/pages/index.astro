---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, slugFromId } from '../lib/posts';
import { categoryDisplayName } from '../data/categories';

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
const recent = rest.slice(0, 8);

const earliestYear = posts[posts.length - 1]?.data.date.getFullYear() ?? 2013;

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
const topics = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([slug, count]) => ({ slug, count, name: categoryDisplayName(slug) }));
---

<BaseLayout>
  <div class="wrap-wide">
    <section class="hero">
      <h1>你好，我是 Sean&ensp;👋</h1>
      <p>
        这里存放着我这些年积累下来的技术笔记——关于 Linux、基础设施、数据库和 AI
        工具的实践与思考，也有少量读书与时事随笔。写下来，是为了把问题想清楚；
        留在这里，是希望恰好对你也有用。
      </p>
      <p class="hero-meta">
        自 {earliestYear} 年至今 · {posts.length} 篇笔记 ·
        <a href="/rss.xml">RSS 订阅</a>
      </p>
    </section>

    {
      featured && (
        <section class="featured-card">
          <p class="kicker">最新一篇</p>
          <h2>
            <a href={`/posts/${slugFromId(featured.id)}/`}>{featured.data.title}</a>
          </h2>
          {featured.data.description && <p>{featured.data.description}</p>}
        </section>
      )
    }

    <div class="section-heading">
      <h2>近期文章</h2>
      <a href="/posts/">全部文章 &rarr;</a>
    </div>
    <ul class="post-list">
      {recent.map((post) => <PostCard post={post} />)}
    </ul>

    <div class="section-heading">
      <h2>按主题漫游</h2>
      <a href="/topics/">全部主题 &rarr;</a>
    </div>
    <div class="topic-cloud">
      {
        topics.map((topic) => (
          <a class="topic-pill" href={`/topics/${topic.slug}/`}>
            {topic.name}
            <span class="topic-pill__count">{topic.count}</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
