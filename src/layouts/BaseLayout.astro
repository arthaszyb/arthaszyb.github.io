---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import { categoryDisplayName } from '../data/categories';
import themeData from '../data/theme.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'website' for regular pages, 'article' for post pages. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  robots?: string;
  /** Post category slug — emitted as schema.org `articleSection`. */
  category?: string;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  tags = [],
  robots = 'index,follow,max-image-preview:large',
  category,
} = Astro.props;

/* 首页（无 title）过去只输出 "Sean Jho"——一个没有任何主题词的标题，
   搜索引擎无从判断这站是讲什么的。补上 tagline。 */
const pageTitle = title ? `${title} - ${site.title}` : `${site.title} - ${site.tagline}`;
const canonicalURL = new URL(Astro.url.pathname, site.url).toString();

/* 主题覆写（src/data/theme.json，可在 Pages CMS「主题与统计」里编辑）：
   留空的项不输出任何 CSS，站点保持 global.css 的默认「暖纸面」设计。
   Pages CMS 保存时会丢弃空字段，所以这里不能依赖 JSON 的字面量类型。 */
const theme = themeData as {
  banner?: { image?: string };
  accent?: { light?: string; dark?: string };
  analytics?: { goatcounter?: string };
  verification?: { google?: string; bing?: string; baidu?: string };
};

/* 搜索引擎站点验证：在 Google Search Console / Bing / 百度站长平台选
   「HTML 标记」方式，把它给的 content 值填进 theme.json（Pages CMS 的
   「主题与统计」里也能填），留空则不输出任何标签。
   这一步不做，站点就永远不会被主动提交 sitemap。 */
const verifications = [
  ['google-site-verification', theme.verification?.google],
  ['msvalidate.01', theme.verification?.bing],
  ['baidu-site-verification', theme.verification?.baidu],
].filter(([, value]) => value?.trim()) as [string, string][];

const themeCss = [
  theme.accent?.light && `:root{--accent:${theme.accent.light};}`,
  theme.accent?.dark && `:root[data-theme='dark']{--accent:${theme.accent.dark};}`,
]
  .filter(Boolean)
  .join('');

const bannerImage = theme.banner?.image?.trim();

const goatcounter = theme.analytics?.goatcounter?.trim();

const author = { '@type': 'Person', name: site.author, url: site.github };

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title ?? site.title,
        description,
        url: canonicalURL,
        datePublished: publishedTime?.toISOString(),
        dateModified: publishedTime?.toISOString(),
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
        inLanguage: 'zh-CN',
        ...(category ? { articleSection: categoryDisplayName(category) } : {}),
        ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
        author,
        publisher: { '@type': 'Person', name: site.author },
        isPartOf: { '@type': 'Blog', name: site.title, url: site.url },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.title,
        alternateName: site.tagline,
        url: site.url,
        description: site.description,
        inLanguage: 'zh-CN',
        author,
        publisher: { '@type': 'Person', name: site.author },
      };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      /* 防闪烁：在任何渲染发生前读取主题偏好并写入 <html data-theme>。
         必须内联且位于 <head> 最前，早于样式表加载。*/
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf6ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#211e19" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    {verifications.map(([name, content]) => <meta name={name} content={content.trim()} />)}

    <title>{pageTitle}</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    {
      type === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {type === 'article' && <meta property="article:author" content={site.author} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? site.title} />
    <meta name="twitter:description" content={description} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {themeCss && <style set:html={themeCss} />}
  </head>
  <body>
    {
      /* 顶部横幅：贯穿整页宽度的固定高度色带，位于每个页面最顶端，
         随页面正常滚动（不遮挡内容）。theme.json 里 banner.image 留空
         则完全不渲染。 */
      bannerImage && (
        <div class="site-banner" style={`background-image:url('${bannerImage}')`} />
      )
    }
    <SiteHeader />
    <main data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />

    {
      /* GoatCounter 访问统计：theme.json 里填入站点代码后自动启用，
         留空则完全不加载脚本。报表在 https://<code>.goatcounter.com 查看。 */
      goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
