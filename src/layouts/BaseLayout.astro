---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import theme from '../data/theme.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'website' for regular pages, 'article' for post pages. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  robots?: string;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  tags = [],
  robots = 'index,follow,max-image-preview:large',
} = Astro.props;

const pageTitle = title ? `${title} - ${site.title}` : site.title;
const canonicalURL = new URL(Astro.url.pathname, site.url).toString();

/* 主题覆写（src/data/theme.json，可在 Pages CMS「主题与统计」里编辑）：
   留空的项不输出任何 CSS，站点保持 global.css 的默认「暖纸面」设计。 */
const themeCss = [
  theme.accent?.light && `:root{--accent:${theme.accent.light};}`,
  theme.accent?.dark && `:root[data-theme='dark']{--accent:${theme.accent.dark};}`,
  theme.background?.colorLight && `:root{--bg:${theme.background.colorLight};}`,
  theme.background?.colorDark && `:root[data-theme='dark']{--bg:${theme.background.colorDark};}`,
  theme.background?.image &&
    `body{background-image:url('${theme.background.image}');background-size:cover;background-position:center;background-attachment:fixed;}`,
]
  .filter(Boolean)
  .join('');

const goatcounter = theme.analytics?.goatcounter?.trim();

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title ?? site.title,
        description,
        datePublished: publishedTime?.toISOString(),
        dateModified: publishedTime?.toISOString(),
        mainEntityOfPage: canonicalURL,
        inLanguage: 'zh-CN',
        ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
        author: { '@type': 'Person', name: site.author, url: site.github },
        publisher: { '@type': 'Person', name: site.author },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.title,
        url: site.url,
        description: site.description,
        inLanguage: 'zh-CN',
        publisher: { '@type': 'Person', name: site.author },
      };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      /* 防闪烁：在任何渲染发生前读取主题偏好并写入 <html data-theme>。
         必须内联且位于 <head> 最前，早于样式表加载。*/
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf6ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#211e19" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    {
      type === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {type === 'article' && <meta property="article:author" content={site.author} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? site.title} />
    <meta name="twitter:description" content={description} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {themeCss && <style set:html={themeCss} />}
  </head>
  <body>
    <SiteHeader />
    <main data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />

    {
      /* GoatCounter 访问统计：theme.json 里填入站点代码后自动启用，
         留空则完全不加载脚本。报表在 https://<code>.goatcounter.com 查看。 */
      goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
